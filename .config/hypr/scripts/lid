#!/bin/sh
# Lid handler, bound to the lid switch in hyprland.lua.
#
# Screen-off on AC; on battery, whatever LID_BATTERY_ACTION says below.
#
# HISTORY, AND HOW TO RE-TEST THIS PROPERLY:
# On kernel 7.1.6-400 the display controller failed to reinitialise on
# resume -- 9/9 suspend cycles came back to a black screen needing a force
# power-off. That is why this was `blank` for a long time. Fixed by kernel
# 7.1.13-402; verified on 2026-09-13 with a real suspend/wake.
#
# DO NOT test it the way the old comment here said to. Two traps:
#   * `IOAVVideoInterface open failed` STILL appears on a perfectly good
#     resume -- it logged 3 times on the successful cycle. It is noise from
#     DCP bring-up, not a failure.
#   * `dcp_poweron() done` does not exist on this kernel, so grepping for it
#     always "fails" no matter what.
#
# The message that actually distinguishes success is the power-state request
# completing well inside its 10s budget:
#     journalctl -b | grep -E 'dcp_set_power_state_req returned'
#     -> apple-dcp ...: dcp_set_power_state_req returned, 9930 ms remaining
# A large "ms remaining" means it came back fast (~70ms here). A hang, or no
# such line at all after a resume, is the real failure.
LID_BATTERY_ACTION=suspend      # blank | suspend

# 1 = plugged in, 0 = on battery
AC=$(cat /sys/class/power_supply/macsmc-ac/online 2>/dev/null || echo 1)

# DPMS rather than disabling the output: disabling makes Hyprland reflow every
# window onto a headless fallback, DPMS just blanks the panel and keeps the
# layout. The {action=...} key is the form this build accepts -- a positional
# string and the mode/state keys are silently ignored.
dpms() { hyprctl eval "hl.dispatch(hl.dsp.dpms({action=\"$1\"}))" >/dev/null 2>&1; }

case "$1" in
    close)
        if [ "$AC" = "0" ] && [ "$LID_BATTERY_ACTION" = "suspend" ]; then
            systemctl suspend
        else
            dpms off
        fi
        ;;
    open)
        dpms on
        ;;
    *)
        echo "usage: $0 {close|open}" >&2
        exit 2
        ;;
esac
