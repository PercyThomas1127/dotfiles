{
    "height": 40, // Waybar height (to be removed for auto height)
    "layer": "top", // Waybar at top layer
    "modules-left": ["custom/launcher", "cpu", "memory", "hyprland/workspaces", "custom/weather"],
    "modules-center": ["custom/spotify"],
    "modules-right": ["tray", "bluetooth", "network", "pulseaudio",  "backlight", "battery", "custom/lock", "clock", "custom/power-menu"],
    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      "format-icons": {
        "active": " 󰮯",
        "default": "󰄰",
      }
    },
    "hyprland/window": {
        "format": "{}"
    },
    "tray": {
        "spacing": 10
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱  {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "~/.config/waybar/scripts/rofi-bluetooth"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%b %d %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },

    "cpu": {
      "interval": 10,
      "format": "󰻠 {}%",
      "max-length": 10,
      "on-click": "",
    },
    "memory": {
        "interval": 30,
        "format": "󰍛 {}%",
        "format-alt":"󰍛 {used:0.1f}GB",
        "max-length": 10,
    },
    "backlight": {
        "device": "apple-panel-bl",
        "format": "{icon}",
        "tooltip-format": "{percent}",
        "format-icons": ["󱩎 ", "󱩏 ", "󱩐 ", "󱩑 ", "󱩒 ", "󱩓 ", "󱩔 ", "󱩕 ", "󱩖 ", "󰛨 "],

    },
    "network": {
        /* "format-wifi": "󰤨", */
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰤯",
        "tooltip-format": "{essid}",
        "on-click": "~/.config/waybar/scripts/network/rofi-network-manager.sh",
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol &"
    },

    "battery": {
      "bat": "macsmc-battery",
      "adapter": "ADP0",
      "interval": 60,
      "states": {
          "warning": 30,
          "critical": 15
      },
      "max-length": 20,
      "format": "{icon} ",
      "format-warning": "{icon}",
      "format-critical": "{icon}",
      "format-charging": "<span font-family='Font Awesome 6 Free'></span>",
      "format-plugged": "󰂄", 

      "format-alt": "{icon} {time}",
      "format-full": "󰂄", 
      "format-icons": ["󱊡", "󱊢", "󱊣"]
    },
    "custom/weather": {
      "exec": "python3 ~/.config/waybar/scripts/weather.py",
      "restart-interval": 300,
      "return-type": "json",
    },   
   "custom/lock": {
       "tooltip" : false,
       "on-click": "swaylock",
       "format" : "",
    },
    "custom/spotify": {
        "exec": "python3 ~/.config/waybar/scripts/mediaplayer.py",
        "format": " {}",
        "return-type": "json",
        // Cap the rendered label so a long title can never push the side groups
        // around. max-length also switches the label to ELLIPSIZE_END, which is
        // what makes it yield instead of shove. 44 leaves ~115px of headroom for
        // the (currently empty) tray and the format-alt states.
        "max-length": 44,
        // Titles containing & < > are otherwise parsed as Pango markup and blank
        // the module. Escaping must happen HERE, after the script has sliced the
        // text -- never in the script, or a scroll window can split an entity.
        "escape": true,
        // format has static content (the glyph), so without this a stray
        // glyph-only pill floats at bar centre when no player is running.
        "hide-empty-text": true,
        // Defaults to true: waybar would respawn the continuous script on every
        // click, blanking the module and resetting the scroll position.
        "exec-on-event": false,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-down": "playerctl previous",
    },
    "custom/power-menu": {
        "format": " ⏻ ",
        "on-click": "bash ~/.config/waybar/scripts/power-menu/powermenu.sh &",
    }, 
    "custom/launcher": {
        "format": "",
        "on-click": "rofi -show drun &",
    },
}
