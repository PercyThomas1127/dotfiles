{
    "height": 40, // Waybar height (to be removed for auto height)
    "layer": "top", // Waybar at top layer
    "modules-left": ["image#launcher", "cpu", "memory", "hyprland/workspaces", "custom/weather"],
    "modules-center": ["group/media"],
    "modules-right": ["tray", "bluetooth", "network", "pulseaudio",  "backlight", "battery", "custom/lock", "clock", "custom/power-menu"],
    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      "format-icons": {
        "active": " 󰮯",
        "default": "󰄰",
      }
    },
    "hyprland/window": {
        "format": "{}"
    },
    "tray": {
        "spacing": 10
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱  {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "~/.config/waybar/scripts/rofi-bluetooth"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%b %d %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },

    "cpu": {
      "interval": 10,
      "format": "󰻠 {}%",
      "max-length": 10,
      "on-click": "",
    },
    "memory": {
        "interval": 30,
        "format": "󰍛 {}%",
        "format-alt":"󰍛 {used:0.1f}GB",
        "max-length": 10,
    },
    "backlight": {
        "device": "apple-panel-bl",
        "format": "{icon}",
        "tooltip-format": "{percent}",
        "format-icons": ["󱩎 ", "󱩏 ", "󱩐 ", "󱩑 ", "󱩒 ", "󱩓 ", "󱩔 ", "󱩕 ", "󱩖 ", "󰛨 "],

    },
    "network": {
        /* "format-wifi": "󰤨", */
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰤯",
        "tooltip-format": "{essid}",
        "on-click": "~/.config/waybar/scripts/network/rofi-network-manager.sh",
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol &"
    },

    "battery": {
      "bat": "macsmc-battery",
      "adapter": "ADP0",
      "interval": 60,
      "states": {
          "warning": 30,
          "critical": 15
      },
      "max-length": 20,
      "format": "{icon} ",
      "format-warning": "{icon}",
      "format-critical": "{icon}",
      "format-charging": "<span font-family='Font Awesome 6 Free'></span>",
      "format-plugged": "󰂄", 

      "format-alt": "{icon} {time}",
      "format-full": "󰂄", 
      "format-icons": ["󱊡", "󱊢", "󱊣"]
    },
    "custom/weather": {
      "exec": "python3 ~/.config/waybar/scripts/weather.py",
      "restart-interval": 300,
      "return-type": "json",
    },   
   "custom/lock": {
       "tooltip" : false,
       // swaylock is NOT INSTALLED on this box -- this was a leftover from the
       // rice and the button silently did nothing. Everything else here locks
       // with hyprlock: hypridle.conf uses `pidof hyprlock || hyprlock` and
       // hyprland.lua binds SUPER+L to it. Same guard, so a second click
       // cannot stack a second lock screen on top of the first.
       "on-click": "pidof hyprlock || hyprlock",
       "format" : "",
    },
    // The art and the title are two widgets that must look like one pill.
    // Grouping them is what makes that safe: the GROUP carries the pill
    // background, so an empty image contributes nothing instead of leaving a
    // stray stub floating at bar centre when there is no artwork.
    "group/media": {
        "orientation": "horizontal",
        "modules": ["image", "custom/spotify"]
    },
    "image": {
        "exec": "~/.config/waybar/scripts/albumart",
        // On-screen size in logical px. Required: with "size" omitted waybar
        // clamps the image to roughly 16px whatever the file contains
        // (measured -- a 36px and a 64px source both rendered identically).
        // It fits the image into a size x size box preserving aspect, which
        // is why scripts/albumart centre-crops to a square; see its header.
        // 48 = 38px of art + the 10px left inset, which the PNG paints in the
        // pill colour so that the image half carries its own rounded end.
        // The HEIGHT is not set here and must not be: it comes out as
        // size * H/W of the canvas, so scripts/albumart-fade picks the canvas
        // ratio (192x175) to land on 43.75 logical px -- the measured height of
        // every other pill in the bar. Raising "size" to grow the image instead
        // would ask for more height than the group has and GTK would scale the
        // whole pixbuf down.
        "size": 48,
        "signal": 5,
        // Would otherwise show the cache file path on hover.
        "tooltip": false,
        "on-click": "playerctl play-pause",
        "on-scroll-down": "playerctl previous"
    },
    "custom/spotify": {
        "exec": "python3 ~/.config/waybar/scripts/mediaplayer.py",
        "format": "{}",
        "return-type": "json",
        // Cap the rendered label so a long title can never push the side groups
        // around. max-length also switches the label to ELLIPSIZE_END, which is
        // what makes it yield instead of shove. 44 leaves ~115px of headroom for
        // the (currently empty) tray and the format-alt states.
        "max-length": 44,
        // Titles containing & < > are otherwise parsed as Pango markup and blank
        // the module. Escaping must happen HERE, after the script has sliced the
        // text -- never in the script, or a scroll window can split an entity.
        "escape": true,
        // Kept as belt-and-braces. It was originally required because format
        // carried the Spotify glyph, so an empty text still rendered a
        // glyph-only pill at bar centre; format is bare "{}" now, but this
        // still guards against a whitespace-only title.
        "hide-empty-text": true,
        // Defaults to true: waybar would respawn the continuous script on every
        // click, blanking the module and resetting the scroll position.
        "exec-on-event": false,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-down": "playerctl previous",
    },
    "custom/power-menu": {
        "format": " ⏻ ",
        "on-click": "bash ~/.config/waybar/scripts/power-menu/powermenu.sh &",
    }, 
    // Was custom/launcher with the Fedora glyph U+F30A. An image module now,
    // because a custom module can only render text and there is no Asahi glyph
    // in Nerd Fonts 3.5.1 -- checked: zero "asahi" matches in the official
    // glyphnames.json, whose 134 font-logos entries match this font's coverage
    // exactly.
    //
    // size 23 matches the glyph it replaces: the Fedora ink measured 22.50 x
    // 22.50 logical px on screen, and the symbol is 460x482, so fitting it to
    // 23 renders 21.95 x 23.0 -- the closest integer match available.
    //
    // assets/asahi.png is NOT the file as supplied. That was 497x502 with 59%
    // transparent padding and the symbol sitting +2.5/-1.0px off the file's
    // centre, so centring the IMAGE would have left the SYMBOL off-centre. It
    // is cropped to the alpha bounding box then re-padded to a square canvas
    // with the symbol centred, verified at dx=0.0 dy=0.0. Squaring also makes
    // this immune to whether waybar fits-to-box or stretches.
    "image#launcher": {
        "path": "/home/yijunchen/.config/waybar/assets/asahi.png",
        "size": 22,
        "on-click": "rofi -show drun &",
        "tooltip": false,
    },
}
