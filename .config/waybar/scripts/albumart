#!/bin/sh
# waybar image-module exec. Prints whichever fade frame the animator selected.
#
# Deliberately trivial: invoked once per animation frame, ~30 times a second
# during a transition, so it must never touch ImageMagick, curl or playerctl.
# All of that is in albumart-fade, off the animation path. Measured ~2ms.
#
# The state file holds a path rather than an index, so the animator can keep
# two frame sets on disk and dip from the outgoing cover to the incoming one.
# It lives in the runtime dir because it describes the CURRENT session only --
# see the comment in albumart-fade.
#
# Printing nothing leaves the previous image in place, which is the only safe
# no-op: waybar's image module never releases its pixbuf. That is fine, because
# the last frame of a fade-out is fully transparent.
RUN="${XDG_RUNTIME_DIR:-/tmp}/waybar-albumart"
REL=$(cat "$RUN/frame" 2>/dev/null) || exit 0
[ -n "$REL" ] || exit 0
[ -f "$RUN/$REL" ] && printf '%s\n' "$RUN/$REL"
